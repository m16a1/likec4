// Global filters apply automatically to all element and deployment views in the project.
global {
  filter 'External systems' where tag is #external
  filter 'Government systems' where tag is #government
  filter 'On-premises systems' where tag is #on-premises
}

views {
  // Inherits all global filters automatically.
  view landscape {
    title 'System Landscape'
    description 'Filter out external, government, or on-premises systems.'

    include *
  }

  // Scoped view: inherits the global filters automatically.
  view corePlatformView of corePlatform {
    title 'Core Platform'
    description 'Scoped view with the global filters.'

    include *
    include -> corePlatform
  }

  // Views can also declare additional per-view filters (or override a global filter by label).
  view containers of corePlatform {
    title 'Core Platform Containers'
    description 'Global filters plus a per-view metadata filter.'

    include *

    filter 'Critical components' where metadata.critical is true
  }
}
