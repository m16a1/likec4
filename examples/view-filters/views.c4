views {
  // Unscoped view: filters are defined on the view itself and
  // appear as checkboxes in the top navigation panel.
  view landscape {
    title 'System Landscape'
    description 'Filter out external, government, or on-premises systems.'

    include *

    filter 'External systems' where tag is #external
    filter 'Government systems' where tag is #government
    filter 'On-premises systems' where tag is #on-premises
  }

  // Scoped view: filters combine with the scope and relationship predicates.
  view corePlatformView of corePlatform {
    title 'Core Platform'
    description 'Scoped view with the same filters.'

    include *
    include -> corePlatform

    filter 'External systems' where tag is #external
    filter 'Government systems' where tag is #government
    filter 'On-premises systems' where tag is #on-premises
  }

  // Filters may use any supported `where` condition, not only tags.
  view containers of corePlatform {
    title 'Core Platform Containers'
    description 'Metadata filter example.'

    include *

    filter 'Critical components' where metadata.critical is true
  }
}
